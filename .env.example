# Copy to .env and fill in. .env is gitignored — never commit real keys.
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=ask-db

# Leave empty for the default namespace.
PINECONE_NAMESPACE=

# How many schema chunks search_schema returns.
TOP_K=8
MAX_TOP_K=30

# Only used if the index was NOT created with integrated embedding.
# Must be the same model you used when upserting the schema.
EMBED_MODEL=multilingual-e5-large

# Optional reranker, e.g. bge-reranker-v2-m3. Empty = off.
RERANK_MODEL=

# Which record/metadata field holds the schema text, and which holds the table
# name. Comma-separated, tried in order. Run `npm run doctor` to see the real
# field names in your index, then narrow these down.
TEXT_FIELDS=chunk_text,text,schema,ddl,create_statement,content,body,description
TABLE_FIELDS=table,table_name,tableName,entity,name

# Told to the LLM so it writes the right flavour of SQL.
SQL_DIALECT=PostgreSQL

# Safety cap on how many records list_tables scans.
LIST_SCAN_LIMIT=1000
